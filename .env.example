# Alpaca: free paper account at https://alpaca.markets (Paper Trading → API keys).
# Crypto data works without keys; stock data and paper trading need them.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# sip covers every exchange back to 2016 and works on the free plan for data older than
# 15 minutes; iex only goes back to mid-2020.
APCA_DATA_FEED=sip

# OpenAI API key for the agent (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
# Optional: override the agent's model.
KESTREL_AGENT_MODEL=gpt-6-sol

KESTREL_ENGINE_PORT=7070
# SQLite file, relative to web/. Point it at a Turso database (libsql://...) with
# DATABASE_AUTH_TOKEN to use hosted SQLite instead.
DATABASE_URL=file:../data/kestrel.db
