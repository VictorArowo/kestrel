# Alpaca: free paper account at https://alpaca.markets (Paper Trading → API keys).
# Crypto data works without keys; stock data and paper trading need them.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# iex on the free plan, sip with a paid data subscription.
APCA_DATA_FEED=iex

# OpenAI API key for the agent (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
# Optional: override the agent's model.
KESTREL_AGENT_MODEL=gpt-6-sol

KESTREL_ENGINE_PORT=7070
DATABASE_URL=postgres://kestrel:kestrel@localhost:5439/kestrel
