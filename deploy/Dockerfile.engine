# The Rust engine: build the kestrel binary, ship it on a slim image.
FROM rust:1.98-bookworm AS build
WORKDIR /src
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release --locked -p kestrel-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/kestrel /usr/local/bin/kestrel
USER 1000:1000
ENV KESTREL_ENGINE_HOST=0.0.0.0 KESTREL_CACHE_DIR=/data/cache
EXPOSE 7070
CMD ["kestrel", "serve"]
